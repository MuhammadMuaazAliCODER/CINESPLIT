DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
MONGODB_URI=
MONGODB_DATABASE=cinesplit
# Cloudinary account cloud name (server-side only).
CLOUDINARY_CLOUD_NAME=
# Cloudinary API key (server-side only).
CLOUDINARY_API_KEY=
# Cloudinary API secret; keep private and never commit backend/.env.
CLOUDINARY_API_SECRET=
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_USE_SSL=False
DEFAULT_FROM_EMAIL=
EMAIL_VERIFICATION_EXPIRY_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
JWT_SECRET_KEY=replace-with-a-separate-long-random-secret
JWT_ACCESS_TOKEN_LIFETIME=15
JWT_REFRESH_TOKEN_LIFETIME=7
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=
